 "attack_tests": "import pytest\n\nif pytest.use_correct:\n    from correct_python_programs.knapsack import knapsack\nelse:\n    from python_programs.knapsack import knapsack\n\n\ndef test_attack_1():\n    # single item that fits exactly: weight == capacity\n    assert knapsack(5, [(5, 10)]) == 10\n\n\ndef test_attack_2():\n    # two items whose sum fits exactly\n    assert knapsack(10, [(5, 10), (5, 10)]) == 20\n\n\ndef test_attack_3():\n    # best solution requires an exact intermediate fit\n    assert knapsack(6, [(5, 10), (1, 5)]) == 15\n\n\ndef test_attack_4():\n    # overweight items must be excluded (catches off-by-one in the other direction)\n    assert knapsack(5, [(6, 100)]) == 0\n    assert knapsack(5, [(6, 100), (5, 10)]) == 10\n\n\ndef test_attack_5():\n    # 0/1 knapsack must not reuse an item (catches unbounded-knapsack fix)\n    assert knapsack(10, [(5, 10)]) == 10\n    assert knapsack(6, [(2, 3)]) == 3\n\n\ndef test_attack_6():\n    # docstring example\n    assert knapsack(100, [(60, 10), (50, 8), (20, 4), (20, 4), (8, 3), (3, 2)]) == 19\n\n\ndef test_attack_7():\n    # edge cases: empty list and zero capacity\n    assert knapsack(10, []) == 0\n    assert knapsack(0, []) == 0\n    assert knapsack(0, [(1, 10), (2, 20)]) == 0\n\n\ndef test_attack_8():\n    # exact final weight is optimal: 6+4=10 -> 46\n    assert knapsack(10, [(6, 30), (3, 14), (4, 16), (2, 9)]) == 46\n",
