 "attack_tests": "import pytest\n\nif pytest.use_correct:\n    from correct_python_programs.subsequences import subsequences\nelse:\n    from python_programs.subsequences import subsequences\n\n\ndef test_attack_1():\n    # Docstring example: b is exclusive, range(a, b)\n    assert subsequences(1, 5, 3) == [[1, 2, 3], [1, 2, 4], [1, 3, 4], [2, 3, 4]]\n\n\ndef test_attack_2():\n    # k == 1 must list singletons of range(a, b), excluding b\n    assert subsequences(1, 5, 1) == [[1], [2], [3], [4]]\n\n\ndef test_attack_3():\n    # k == n (exactly fits) yields single sequence\n    assert subsequences(0, 3, 3) == [[0, 1, 2]]\n\n\ndef test_attack_4():\n    # k larger than available elements yields no sequences\n    assert subsequences(1, 5, 5) == []\n    assert subsequences(1, 3, 5) == []\n    assert subsequences(0, 2, 3) == []\n\n\ndef test_attack_5():\n    # empty or inverted range yields no sequences for k > 0\n    assert subsequences(5, 5, 1) == []\n    assert subsequences(5, 5, 2) == []\n    assert subsequences(5, 3, 1) == []\n    assert subsequences(5, 3, 2) == []\n\n\ndef test_attack_6():\n    # full enumeration, order matters, C(5,2)=10\n    assert subsequences(0, 5, 2) == [\n        [0, 1], [0, 2], [0, 3], [0, 4],\n        [1, 2], [1, 3], [1, 4],\n        [2, 3], [2, 4],\n        [3, 4],\n    ]\n\n\ndef test_attack_7():\n    # must include b-1 but not b\n    assert subsequences(2, 6, 3) == [[2, 3, 4], [2, 3, 5], [2, 4, 5], [3, 4, 5]]\n\n\ndef test_attack_8():\n    # negative start still follows range(a, b) semantics\n    assert subsequences(-1, 2, 2) == [[-1, 0], [-1, 1], [0, 1]]\n",
